---
// A roundup's picks as cards, grouped by day, plus their Event JSON-LD.
import { byDate, longDate, mapUrl, picksJsonLd, tileColors, type Roundup } from '../lib/picks';

interface Props {
  roundup: Roundup;
  headingLevel?: 'h2' | 'h3';
}
const { roundup, headingLevel = 'h2' } = Astro.props;
const DayHeading = headingLevel;
const NameHeading = headingLevel === 'h2' ? 'h3' : 'h4';
// Index across the whole roundup, for picks with no tile color
let n = 0;
---

<script type="application/ld+json" set:html={picksJsonLd(roundup)} />

<div class="space-y-8">
  {byDate(roundup).map(([date, picks]) => (
    <section>
      <DayHeading class="text-xs font-semibold uppercase tracking-widest text-stone-600 mb-3">{longDate(date)}</DayHeading>
      <div class="grid gap-4 sm:grid-cols-2">
        {picks.map((p) => {
          const c = tileColors(p, n++);
          return (
          <article class="pick-tile rounded-2xl shadow-md p-5 flex flex-col" style={`--tile-bg: ${c.bg}; --tile-accent: ${c.accent}`}>
            <p class="pick-label text-xs font-semibold mb-1.5">
              {p.emoji && <span aria-hidden="true">{p.emoji} </span>}
              {p.slot === 'day' ? 'Day · ' : p.slot === 'night' ? 'Night · ' : ''}{p.category}
            </p>
            <NameHeading class="text-lg font-semibold text-white leading-snug mb-2" style="font-family: var(--font-serif)">{p.name}</NameHeading>
            {p.description && <p class="text-sm text-white/75 leading-relaxed mb-3">{p.description}</p>}
            <p class="mt-auto text-sm text-white/60">
              {p.venue && <a href={mapUrl(p.venue)} target="_blank" rel="noopener noreferrer" class="pick-venue font-medium text-white/90">{p.venue}</a>}
              {p.venue && p.details && ' · '}
              {p.details}
              {p.endDate && <> · through {longDate(p.endDate)}</>}
            </p>
          </article>
          );
        })}
      </div>
    </section>
  ))}
</div>

<style>
  .pick-tile { background: var(--tile-bg); }
  .pick-label { color: var(--tile-accent); }
  .pick-venue:hover { color: var(--tile-accent); }
</style>
