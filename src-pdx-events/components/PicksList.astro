---
// A roundup's picks as cards, grouped by day, plus their Event JSON-LD.
import { byDate, longDate, mapUrl, picksJsonLd, type Roundup } from '../lib/picks';

interface Props {
  roundup: Roundup;
  headingLevel?: 'h2' | 'h3';
}
const { roundup, headingLevel = 'h2' } = Astro.props;
const DayHeading = headingLevel;
const NameHeading = headingLevel === 'h2' ? 'h3' : 'h4';
---

<script type="application/ld+json" set:html={picksJsonLd(roundup)} />

<div class="space-y-8">
  {byDate(roundup).map(([date, picks]) => (
    <section>
      <DayHeading class="text-xs font-semibold uppercase tracking-widest text-stone-500 mb-3">{longDate(date)}</DayHeading>
      <div class="grid gap-4 sm:grid-cols-2">
        {picks.map((p) => (
          <article class="bg-white rounded-2xl border border-stone-100 shadow-sm p-5 flex flex-col">
            <p class="text-xs font-semibold text-orange-600 mb-1.5">
              {p.emoji && <span aria-hidden="true">{p.emoji} </span>}
              {p.slot === 'day' ? 'Day · ' : p.slot === 'night' ? 'Night · ' : ''}{p.category}
            </p>
            <NameHeading class="text-lg font-semibold text-stone-900 leading-snug mb-2" style="font-family: var(--font-serif)">{p.name}</NameHeading>
            {p.description && <p class="text-sm text-stone-600 leading-relaxed mb-3">{p.description}</p>}
            <p class="mt-auto text-sm text-stone-500">
              {p.venue && <a href={mapUrl(p.venue)} target="_blank" rel="noopener noreferrer" class="font-medium text-stone-700 hover:text-orange-600">{p.venue}</a>}
              {p.venue && p.details && ' · '}
              {p.details}
              {p.endDate && <> · through {longDate(p.endDate)}</>}
            </p>
          </article>
        ))}
      </div>
    </section>
  ))}
</div>
