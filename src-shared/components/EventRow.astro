---
import type { CalEvent } from '../lib/google-calendar';
import { COLOR_MAP } from '../lib/calendars';

interface Props {
  event: CalEvent;
}
const { event: e } = Astro.props;
const colors = COLOR_MAP[e.color] ?? COLOR_MAP['orange'];
const link = e.url || e.googleUrl;

// Compact single-line event row. Uses the short .er-* classes defined in
// EventsView (not Tailwind utilities) to keep the HTML small. The markup MUST
// stay in sync with rowHtml() in EventsView's script, which renders the rows
// that aren't server-rendered. (Comment lives here, not in the template, so it
// isn't emitted once per row.)
---

<li class="er">
  <span class={`er-dot ${colors.dot}`} title={e.calendarName}></span>
  <span class="er-time">{e.allDay ? 'all day' : e.time}</span>
  <span class="er-main">
    {link ? (
      <a href={link} target="_blank" rel="noopener noreferrer" class="er-title">{e.title}</a>
    ) : (
      <span class="er-title">{e.title}</span>
    )}
    {e.location && <span class="er-loc"> · {e.location}</span>}
    {e.mapUrl && (
      <a href={e.mapUrl} target="_blank" rel="noopener noreferrer" class="er-map" title="Open in Google Maps">📍(map)</a>
    )}
  </span>
  {e.costClass === 'free' ? (
    <span class="er-free">Free</span>
  ) : e.cost ? (
    <span class="er-cost">{e.cost}</span>
  ) : null}
</li>
