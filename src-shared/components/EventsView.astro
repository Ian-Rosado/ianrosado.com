---
import EventRow from './EventRow.astro';
import { COLOR_MAP } from '../lib/calendars';
import {
  fetchAllEvents,
  EVENT_CATEGORIES,
} from '../lib/events';
import { groupByDate, formatDisplayDate } from '../lib/google-calendar';

// Only the first few days are server-rendered. Rendering all ~90 days made
// the page 12 MB of HTML (slow on phones, truncated by crawlers); the rest is
// rendered client-side from /events.json (see src-shared/lib/events-payload).
const SSR_DAYS = 3;

const allEvents = await fetchAllEvents();
const grouped = groupByDate(allEvents);
const ssrDays = [...grouped.entries()].slice(0, SSR_DAYS);

const totalCount = allEvents.length;
const freeCount = allEvents.filter((e) => e.costClass === 'free').length;

// Date range for the list-view date picker
const dateKeys = [...grouped.keys()].sort();
const minDate = dateKeys[0] ?? '';
const maxDate = dateKeys[dateKeys.length - 1] ?? '';

---

<div class="events-view max-w-3xl lg:max-w-5xl mx-auto px-4 py-8">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
    <p class="text-stone-500 text-sm">
      <span id="result-count">{totalCount}</span> upcoming events · {freeCount} free
    </p>

    <!-- View toggle (calendar option hidden on small screens) -->
    <div class="hidden lg:inline-flex rounded-lg border border-stone-200 overflow-hidden text-sm">
      <button id="view-list" class="view-btn px-3 py-1.5 font-medium" aria-pressed="true">List</button>
      <button id="view-calendar" class="view-btn px-3 py-1.5 font-medium border-l border-stone-200" aria-pressed="false">Calendar</button>
    </div>
  </div>

  <!-- Filter bar -->
  <div class="sticky top-0 z-40 bg-white/95 backdrop-blur py-3 -mx-4 px-4 border-b border-stone-100 mb-6">
    <input
      type="search"
      id="search-input"
      placeholder="Search events or venues…"
      class="w-full mb-3 px-3 py-2 text-sm rounded-lg border border-stone-200 focus:outline-none focus:ring-2 focus:ring-orange-300"
    />
    <div class="flex flex-wrap items-center gap-2 mb-2">
      <span class="text-xs font-semibold text-stone-400 uppercase tracking-wide mr-1">Cost</span>
      <button class="filter-pill" data-filter="cost" data-value="all" aria-pressed="true">All</button>
      <button class="filter-pill" data-filter="cost" data-value="free" aria-pressed="false">Free only</button>
      <button class="filter-pill" data-filter="cost" data-value="paid" aria-pressed="false">Paid</button>

      <!-- Date picker (list view): jump/filter to a chosen day -->
      <div id="date-filter-group" class="flex items-center gap-1.5 ml-auto">
        <label for="date-input" class="text-xs font-semibold text-stone-400 uppercase tracking-wide">Date</label>
        <input
          type="date"
          id="date-input"
          min={minDate}
          max={maxDate}
          class="px-2 py-1 text-xs rounded-lg border border-stone-200 text-stone-600 focus:outline-none focus:ring-2 focus:ring-orange-300"
        />
        <button id="date-clear" class="hidden filter-pill" aria-label="Clear date filter">Clear</button>
      </div>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-xs font-semibold text-stone-400 uppercase tracking-wide mr-1">Type</span>
      <button class="filter-pill" data-filter="category" data-value="all" aria-pressed="true">All</button>
      {EVENT_CATEGORIES.map((cat) => (
        <button class="filter-pill flex items-center gap-1.5" data-filter="category" data-value={cat.slug} aria-pressed="false">
          <span class={`w-2 h-2 rounded-full ${(COLOR_MAP[cat.color] ?? COLOR_MAP['orange']).dot}`}></span>
          {cat.label}
        </button>
      ))}
    </div>
  </div>


  <!-- ===================== LIST VIEW ===================== -->
  <!-- Server renders the first SSR_DAYS days; the script appends the rest
       from /events.json as the user scrolls, and re-renders on filter. -->
  <div id="list-view">
    <div id="list-days">
      {ssrDays.map(([date, dayEvents]) => (
        <section class="date-group mb-5" data-date={date}>
          <h2 class="date-heading text-xs font-semibold uppercase tracking-widest text-stone-500 mb-1.5 sticky top-[120px] bg-white/90 backdrop-blur py-0.5">{formatDisplayDate(date)}</h2>
          <ul class="divide-y divide-stone-50">
            {dayEvents.map((event) => <EventRow event={event} />)}
          </ul>
        </section>
      ))}
    </div>
    <div id="list-sentinel" aria-hidden="true"></div>
    <p id="list-status" class={`text-center py-6 text-sm text-stone-400 ${dateKeys.length > SSR_DAYS ? '' : 'hidden'}`}>Loading more events…</p>
    <div id="no-results" class="hidden text-center py-12">
      <p class="text-stone-400 text-sm mb-3">No events match your filters.</p>
      <button id="clear-filters"
        class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium rounded-lg bg-orange-600 text-white hover:bg-orange-700 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
        Clear all filters
      </button>
    </div>
  </div>

  <!-- ===================== CALENDAR VIEW (desktop only) ===================== -->
  <!-- Month grid is built client-side from /events.json when shown. -->
  <div id="calendar-view" class="hidden">
    <!-- Month nav -->
    <div class="flex items-center justify-center gap-4 mb-4">
      <button id="cal-prev" class="px-2 py-1 rounded hover:bg-stone-100 text-stone-500" aria-label="Previous month">‹</button>
      <h2 id="cal-month-label" class="text-lg font-semibold text-stone-900 w-48 text-center" style="font-family: var(--font-serif)"></h2>
      <button id="cal-next" class="px-2 py-1 rounded hover:bg-stone-100 text-stone-500" aria-label="Next month">›</button>
    </div>

    <div class="grid grid-cols-7 text-center text-xs font-semibold uppercase tracking-wide text-stone-400 mb-1">
      {['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].map((w) => <div class="py-1">{w}</div>)}
    </div>
    <div id="cal-grid" class="grid grid-cols-7 gap-px bg-stone-100 border border-stone-100 rounded-lg overflow-hidden"></div>

    <!-- Single shared popover, positioned + populated on day click -->
    <div id="cal-popover" class="hidden fixed z-50 w-80 max-h-96 overflow-y-auto bg-white rounded-xl border border-stone-200 shadow-xl p-3">
      <div id="cal-popover-date" class="text-xs font-semibold uppercase tracking-widest text-stone-500 mb-2"></div>
      <ul id="cal-popover-list" class="divide-y divide-stone-50"></ul>
    </div>
  </div>
</div>

<style>
  .filter-pill {
    font-size: 0.75rem;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    border: 1px solid rgb(231 229 228);
    color: rgb(120 113 108);
    background: white;
    transition: all 0.12s;
    cursor: pointer;
  }
  .filter-pill:hover { border-color: rgb(251 146 60); color: rgb(234 88 12); }
  .filter-pill[aria-pressed="true"] {
    background: rgb(234 88 12);
    border-color: rgb(234 88 12);
    color: white;
  }
  .filter-pill[aria-pressed="true"] .w-2 { background: white !important; }
  .view-btn[aria-pressed="true"] { background: rgb(234 88 12); color: white; }
  .view-btn[aria-pressed="false"] { background: white; color: rgb(120 113 108); }

  /* iOS Safari auto-zooms when focusing an input with font-size < 16px and
     doesn't zoom back out. Force 16px on touch devices to prevent it. */
  @media (pointer: coarse) {
    .events-view input[type="search"],
    .events-view input[type="date"] {
      font-size: 16px;
    }
  }
</style>

<!-- Event row styles. Global (not scoped) because rows come from EventRow and
     from innerHTML; short class names keep thousands of rows compact. -->
<style is:global>
  .events-view .er {
    display: flex; align-items: baseline; gap: 0.5rem;
    padding: 0.375rem 0.5rem; margin: 0 -0.5rem; border-radius: 0.25rem;
    transition: background-color 0.15s;
  }
  .events-view .er:hover { background: rgb(250 250 249); }
  .events-view .er-dot {
    margin-top: 0.375rem; flex-shrink: 0; width: 0.5rem; height: 0.5rem; border-radius: 9999px;
  }
  .events-view .er-time {
    flex-shrink: 0; width: 4rem; text-align: right;
    font-size: 0.75rem; line-height: 1rem; font-variant-numeric: tabular-nums; color: rgb(168 162 158);
  }
  .events-view .er-main {
    flex: 1; min-width: 0; font-size: 0.875rem; line-height: 1.375; overflow-wrap: break-word;
  }
  .events-view .er-title { color: rgb(28 25 23); font-weight: 500; transition: color 0.15s; }
  .events-view a.er-title:hover { color: rgb(234 88 12); }
  .events-view .er-loc { color: rgb(168 162 158); }
  .events-view .er-map {
    margin-left: 0.25rem; white-space: nowrap; font-size: 0.75rem; color: rgb(234 88 12);
  }
  .events-view .er-map:hover { color: rgb(194 65 12); text-decoration: underline; }
  .events-view .er-free { flex-shrink: 0; font-size: 0.75rem; line-height: 1rem; font-weight: 600; color: rgb(21 128 61); }
  .events-view .er-cost { flex-shrink: 0; font-size: 0.75rem; line-height: 1rem; color: rgb(120 113 108); }
</style>

<script>
  // ---- Data -------------------------------------------------------------
  // Full event list comes from /events.json (shape documented in
  // src-shared/lib/events-payload.ts). Until it arrives, only the
  // server-rendered first days are on the page; filter changes made in the
  // meantime are applied as soon as it loads.
  type EventTuple = [number, string, string, string, string, string, string, string];
  interface Ev {
    cat: number; time: string; title: string; loc: string; map: string;
    cost: string; cc: string; link: string; titleLc: string; locLc: string;
  }
  interface Day { date: string; events: Ev[] }

  const TZ = 'America/Los_Angeles';
  const MAP_PREFIX = 'https://www.google.com/maps/search/?api=1&query=';
  const ROWS_PER_CHUNK = 150; // rows appended per scroll step
  const PRELOAD_PX = 1500;    // render ahead this far below the viewport
  const MAX_CHIPS = 4;        // events shown in a calendar cell before "+N more"

  let cats: [string, string, string][] = []; // [slug, dotClass, calendarName]
  let allDays: Day[] | null = null;
  const dayMap = new Map<string, Ev[]>();
  let viewDays: Day[] = [];   // allDays after filters — what the list shows
  let renderedIdx = 0;        // how many of viewDays are in the DOM
  let pendingApply = false;

  // ---- Filtering (shared by both views) --------------------------------
  // `date` is a list-view-only filter (YYYY-MM-DD, '' = all dates).
  // `categories` is a multi-select set of slugs; empty = show all types.
  const state = {
    cost: 'all',
    categories: new Set<string>(),
    search: '',
    date: '',
  };

  const listDays = document.getElementById('list-days')!;
  const sentinel = document.getElementById('list-sentinel')!;
  const listStatus = document.getElementById('list-status');
  const countEl = document.getElementById('result-count');
  const noResults = document.getElementById('no-results');
  const eventsView = document.querySelector<HTMLElement>('.events-view');

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) => (
      { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string
    ));
  }

  // Same output as formatDisplayDate() in google-calendar.ts: "Sat, Jun 7"
  function dayLabel(date: string): string {
    return new Date(date + 'T12:00:00').toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
  }

  // Must match EventRow.astro's markup.
  function rowHtml(ev: Ev): string {
    const [, dot, calName] = cats[ev.cat] ?? ['', 'bg-orange-500', ''];
    const title = ev.link
      ? `<a href="${escapeHtml(ev.link)}" target="_blank" rel="noopener noreferrer" class="er-title">${escapeHtml(ev.title)}</a>`
      : `<span class="er-title">${escapeHtml(ev.title)}</span>`;
    const loc = ev.loc ? `<span class="er-loc"> · ${escapeHtml(ev.loc)}</span>` : '';
    const map = ev.map
      ? `<a href="${escapeHtml(MAP_PREFIX + ev.map)}" target="_blank" rel="noopener noreferrer" class="er-map" title="Open in Google Maps">📍(map)</a>`
      : '';
    const cost = ev.cc === 'free'
      ? '<span class="er-free">Free</span>'
      : ev.cost ? `<span class="er-cost">${escapeHtml(ev.cost)}</span>` : '';
    return `<li class="er"><span class="er-dot ${dot}" title="${escapeHtml(calName)}"></span><span class="er-time">${escapeHtml(ev.time)}</span><span class="er-main">${title}${loc} ${map}</span>${cost}</li>`;
  }

  // Must match the date-group section in the template above.
  function dayHtml(day: Day): string {
    return `<section class="date-group mb-5" data-date="${day.date}"><h2 class="date-heading text-xs font-semibold uppercase tracking-widest text-stone-500 mb-1.5 sticky top-[120px] bg-white/90 backdrop-blur py-0.5">${dayLabel(day.date)}</h2><ul class="divide-y divide-stone-50">${day.events.map(rowHtml).join('')}</ul></section>`;
  }

  function matches(ev: Ev): boolean {
    const okCost = state.cost === 'all' || ev.cc === state.cost;
    const okCat = state.categories.size === 0 || state.categories.has(cats[ev.cat]?.[0] ?? '');
    const okSearch = !state.search || ev.titleLc.includes(state.search) || ev.locLc.includes(state.search);
    return okCost && okCat && okSearch;
  }

  // ---- List rendering (incremental) -------------------------------------
  function isListVisible(): boolean {
    return !document.getElementById('list-view')?.classList.contains('hidden');
  }

  function renderMore() {
    let rows = 0;
    let html = '';
    while (renderedIdx < viewDays.length && rows < ROWS_PER_CHUNK) {
      const day = viewDays[renderedIdx++];
      html += dayHtml(day);
      rows += day.events.length;
    }
    if (html) listDays.insertAdjacentHTML('beforeend', html);
  }

  // Keep appending while the end of the list is within PRELOAD_PX of the
  // viewport. One chunk per frame so a long list never blocks scrolling.
  function fillList() {
    if (!allDays || !isListVisible() || renderedIdx >= viewDays.length) return;
    if (sentinel.getBoundingClientRect().top > window.innerHeight + PRELOAD_PX) return;
    renderMore();
    requestAnimationFrame(fillList);
  }
  // A scroll listener rather than an IntersectionObserver: a fast fling or a
  // jump (End key, scrollbar drag) can skip past the sentinel entirely, and an
  // observer never fires in that case.
  let fillQueued = false;
  window.addEventListener('scroll', () => {
    if (fillQueued) return;
    fillQueued = true;
    requestAnimationFrame(() => { fillQueued = false; fillList(); });
  }, { passive: true });
  window.addEventListener('resize', fillList, { passive: true });

  // After a filter change, scroll back to the top of the results so the user
  // sees the filtered list from the start. Deferred to the next frame so it
  // runs AFTER the filter change reflows, the browser re-clamps the scroll, and
  // (for the date input) the native picker finishes dismissing — a scroll fired
  // synchronously in that window gets dropped, especially switching date→date.
  // Compute the absolute target rather than scrollIntoView so the result is
  // predictable regardless of the interim clamped position.
  // `delay` lets the date input wait out its native picker's dismissal
  // animation (which outlasts a single frame); pills use a short default.
  // `behavior: 'auto'` (instant) avoids a smooth animation being interrupted
  // mid-scroll, used for the fragile date case.
  function scrollToResultsTop(delay = 120, behavior: ScrollBehavior = 'smooth') {
    if (!eventsView) return;
    setTimeout(() => {
      const top = window.scrollY + eventsView.getBoundingClientRect().top;
      window.scrollTo({ top, behavior });
    }, delay);
  }

  function apply() {
    if (!allDays) { pendingApply = true; return; }
    viewDays = [];
    let visible = 0;
    for (const day of allDays) {
      if (state.date && day.date !== state.date) continue;
      const events = day.events.filter(matches);
      if (events.length) {
        viewDays.push({ date: day.date, events });
        visible += events.length;
      }
    }
    listDays.innerHTML = '';
    renderedIdx = 0;
    renderMore();
    fillList();

    if (countEl) countEl.textContent = String(visible);
    if (noResults) noResults.classList.toggle('hidden', visible !== 0);
    if (isCalendarVisible()) renderMonth(monthIdx);
  }

  // Reflect the category set onto the Type pills' pressed state.
  // "All" is pressed only when no specific types are selected.
  function syncCategoryPills() {
    document.querySelectorAll<HTMLElement>('.filter-pill[data-filter="category"]').forEach((b) => {
      const v = b.dataset.value!;
      const on = v === 'all' ? state.categories.size === 0 : state.categories.has(v);
      b.setAttribute('aria-pressed', String(on));
    });
  }

  document.querySelectorAll<HTMLElement>('.filter-pill').forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter as 'cost' | 'category' | undefined;
      if (!filter) return; // e.g. the date-clear button reuses .filter-pill styling
      const value = btn.dataset.value!;

      if (filter === 'cost') {
        // Single-select, but clicking the active non-"all" pill reverts to All.
        state.cost = state.cost === value && value !== 'all' ? 'all' : value;
        document.querySelectorAll<HTMLElement>('.filter-pill[data-filter="cost"]')
          .forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.value === state.cost)));
      } else {
        // Multi-select set. "All" clears; any pill toggles on/off.
        if (value === 'all') {
          state.categories.clear();
        } else if (state.categories.has(value)) {
          state.categories.delete(value);
        } else {
          state.categories.add(value);
        }
        syncCategoryPills();
      }
      apply();
      scrollToResultsTop();
    });
  });

  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  searchInput?.addEventListener('input', () => {
    state.search = searchInput.value.trim().toLowerCase();
    apply();
  });

  // ---- Date picker (list view only) ------------------------------------
  const dateInput = document.getElementById('date-input') as HTMLInputElement | null;
  const dateClear = document.getElementById('date-clear');
  function setDate(value: string) {
    state.date = value;
    if (dateInput) dateInput.value = value;
    dateClear?.classList.toggle('hidden', !value);
    apply();
    // Scroll back to the top of the results rather than to the chosen day, so
    // the filtered list reads from the start. Longer delay to outlast the native
    // picker dismissal, and instant behavior so it can't be interrupted.
    scrollToResultsTop(350, 'auto');
  }
  dateInput?.addEventListener('change', () => {
    // iOS keeps the date input focused after the picker closes, and ignores
    // programmatic scrolls while a field is focused — blur to release that lock
    // so the scroll-to-top actually takes effect (the date→date "no scroll" bug).
    dateInput.blur();
    setDate(dateInput.value);
  });
  dateClear?.addEventListener('click', () => setDate(''));

  document.getElementById('clear-filters')?.addEventListener('click', () => {
    state.cost = 'all'; state.categories.clear(); state.search = ''; state.date = '';
    if (searchInput) searchInput.value = '';
    if (dateInput) dateInput.value = '';
    dateClear?.classList.add('hidden');
    document.querySelectorAll<HTMLElement>('.filter-pill[data-filter="cost"]')
      .forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.value === 'all')));
    syncCategoryPills();
    apply();
    scrollToResultsTop();
  });

  // ---- View toggle (List / Calendar) -----------------------------------
  const listViewEl = document.getElementById('list-view');
  const calendarViewEl = document.getElementById('calendar-view');
  const btnList = document.getElementById('view-list');
  const btnCal = document.getElementById('view-calendar');

  const dateFilterGroup = document.getElementById('date-filter-group');
  function isCalendarVisible(): boolean {
    return !calendarViewEl?.classList.contains('hidden');
  }
  function setView(view: 'list' | 'calendar') {
    const isList = view === 'list';
    listViewEl?.classList.toggle('hidden', !isList);
    calendarViewEl?.classList.toggle('hidden', isList);
    btnList?.setAttribute('aria-pressed', String(isList));
    btnCal?.setAttribute('aria-pressed', String(!isList));
    // Date picker only makes sense in list view
    dateFilterGroup?.classList.toggle('hidden', !isList);
    if (isList) fillList(); else renderMonth(monthIdx);
  }
  btnList?.addEventListener('click', () => setView('list'));
  btnCal?.addEventListener('click', () => setView('calendar'));

  // ---- Calendar month grid (desktop only) -------------------------------
  // One month at a time, Sun–Sat weeks, from the current Pacific month
  // through the furthest event. Rebuilt on navigation and filter changes.
  const calGrid = document.getElementById('cal-grid');
  const monthLabel = document.getElementById('cal-month-label');
  const calPrev = document.getElementById('cal-prev') as HTMLButtonElement | null;
  const calNext = document.getElementById('cal-next') as HTMLButtonElement | null;
  const todayStr = new Date().toLocaleDateString('en-CA', { timeZone: TZ }); // YYYY-MM-DD
  let months: [number, number][] = []; // [year, monthIndex]
  let monthIdx = 0;

  function buildMonthList() {
    const [ty, tm] = todayStr.split('-').map(Number);
    const last = allDays?.length ? allDays[allDays.length - 1].date : todayStr;
    const [ly, lm] = last.split('-').map(Number);
    months = [];
    for (let y = ty, m = tm - 1; y * 12 + m <= ly * 12 + lm - 1; ) {
      months.push([y, m]);
      if (++m === 12) { m = 0; y++; }
    }
  }

  function renderMonth(idx: number) {
    if (!allDays || !calGrid || !months.length) return;
    monthIdx = Math.max(0, Math.min(idx, months.length - 1));
    const [y, m] = months[monthIdx];
    const first = new Date(y, m, 1);
    if (monthLabel) monthLabel.textContent = first.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

    const startPad = first.getDay(); // 0=Sun
    const daysInMonth = new Date(y, m + 1, 0).getDate();
    const pad = '<div class="cal-cell relative bg-white min-h-[110px] p-1.5 bg-stone-50/50"></div>';
    let html = pad.repeat(startPad);
    for (let d = 1; d <= daysInMonth; d++) {
      const ds = `${y}-${String(m + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
      const events = (dayMap.get(ds) ?? []).filter(matches);
      const dayNum = ds === todayStr
        ? `<div class="text-xs mb-1 font-bold text-white bg-orange-600 rounded-full w-5 h-5 inline-flex items-center justify-center">${d}</div>`
        : `<div class="text-xs mb-1 text-stone-400">${d}</div>`;
      const chips = events.slice(0, MAX_CHIPS).map((ev) =>
        `<div class="cal-chip flex items-center gap-1 text-[11px] leading-tight truncate"><span class="flex-shrink-0 w-1.5 h-1.5 rounded-full ${cats[ev.cat]?.[1] ?? ''}"></span><span class="truncate text-stone-700">${ev.time === 'all day' ? '' : escapeHtml(ev.time) + ' '}${escapeHtml(ev.title)}</span></div>`,
      ).join('');
      const more = events.length > MAX_CHIPS
        ? `<div class="cal-more text-[11px] text-stone-400 pl-2.5">+${events.length - MAX_CHIPS} more</div>`
        : '';
      html += `<div class="cal-cell relative bg-white min-h-[110px] p-1.5 text-left align-top ${events.length ? 'cursor-pointer hover:bg-orange-50/40' : ''}" data-date="${ds}"${events.length ? ' data-has-events' : ''}>${dayNum}<div class="space-y-0.5">${chips}${more}</div></div>`;
    }
    html += pad.repeat((7 - ((startPad + daysInMonth) % 7)) % 7);
    calGrid.innerHTML = html;
    closePopover();

    if (calPrev) { calPrev.disabled = monthIdx === 0; calPrev.style.opacity = monthIdx === 0 ? '0.3' : '1'; }
    const atEnd = monthIdx === months.length - 1;
    if (calNext) { calNext.disabled = atEnd; calNext.style.opacity = atEnd ? '0.3' : '1'; }
  }
  calPrev?.addEventListener('click', () => renderMonth(monthIdx - 1));
  calNext?.addEventListener('click', () => renderMonth(monthIdx + 1));

  // ---- Day popover (single shared element) ------------------------------
  const popover = document.getElementById('cal-popover');
  const popDate = document.getElementById('cal-popover-date');
  const popList = document.getElementById('cal-popover-list');
  let openCell: HTMLElement | null = null;

  function closePopover() {
    popover?.classList.add('hidden');
    openCell = null;
  }

  function openPopover(cell: HTMLElement, date: string) {
    const events = (dayMap.get(date) ?? []).filter(matches);
    if (!events.length || !popover || !popDate || !popList) return;
    popDate.textContent = dayLabel(date);
    popList.innerHTML = events.map(rowHtml).join('');

    // Position near the clicked cell, clamped to viewport
    const r = cell.getBoundingClientRect();
    popover.classList.remove('hidden');
    const pw = popover.offsetWidth, ph = popover.offsetHeight;
    let left = r.left;
    let top = r.bottom + 4;
    if (left + pw > window.innerWidth - 8) left = window.innerWidth - pw - 8;
    if (top + ph > window.innerHeight - 8) top = Math.max(8, r.top - ph - 4);
    popover.style.left = `${Math.max(8, left)}px`;
    popover.style.top = `${top}px`;
    openCell = cell;
  }

  calGrid?.addEventListener('click', (e) => {
    const cell = (e.target as HTMLElement).closest<HTMLElement>('.cal-cell[data-has-events]');
    if (!cell?.dataset.date) return;
    e.stopPropagation();
    if (openCell === cell) { closePopover(); return; }
    openPopover(cell, cell.dataset.date);
  });
  popover?.addEventListener('click', (e) => e.stopPropagation());
  document.addEventListener('click', closePopover);
  // Close when the page scrolls (fixed popover would detach from its cell),
  // but ignore scrolling *inside* the popover's own scrollable list.
  window.addEventListener('scroll', (e) => {
    if (popover && !popover.classList.contains('hidden') && popover.contains(e.target as Node)) return;
    closePopover();
  }, true);

  // Calendar view is desktop-only — force list below the lg breakpoint
  const lgQuery = window.matchMedia('(min-width: 1024px)');
  function enforceBreakpoint() {
    if (!lgQuery.matches) setView('list');
  }
  lgQuery.addEventListener('change', enforceBreakpoint);
  enforceBreakpoint();

  // ---- Load the full event list -----------------------------------------
  fetch('/events.json')
    .then((r) => {
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      return r.json();
    })
    .then((data: { cats: [string, string, string][]; days: [string, EventTuple[]][] }) => {
      cats = data.cats;
      allDays = data.days.map(([date, tuples]) => {
        const events = tuples.map(([cat, time, title, loc, map, cost, cc, link]) => ({
          cat, time, title, loc, map, cost, cc, link,
          titleLc: title.toLowerCase(), locLc: loc.toLowerCase(),
        }));
        dayMap.set(date, events);
        return { date, events };
      });
      buildMonthList();
      listStatus?.classList.add('hidden');

      if (pendingApply) {
        apply();
      } else {
        // No filters yet: keep the server-rendered days and continue after them.
        viewDays = allDays;
        renderedIdx = listDays.querySelectorAll('.date-group').length;
        fillList();
        if (isCalendarVisible()) renderMonth(monthIdx);
      }
    })
    .catch((err) => {
      console.error('Failed to load /events.json', err);
      if (listStatus) {
        listStatus.textContent = "Couldn't load the rest of the events — try refreshing the page.";
        listStatus.classList.remove('hidden');
      }
    });
</script>
