---
import type { CalEvent } from '../lib/google-calendar';
import { COLOR_MAP } from '../lib/calendars';

interface Props {
  event: CalEvent;
}
const { event: e } = Astro.props;
const colors = COLOR_MAP[e.color] ?? COLOR_MAP['orange'];
const link = e.url || e.googleUrl;

// Compact single-line event row. Uses the short .er-* classes defined in
// EventsView (not Tailwind utilities) to keep the HTML small. The markup MUST
// stay in sync with rowHtml() in EventsView's script, which renders the rows
// that aren't server-rendered. (Comment lives here, not in the template, so it
// isn't emitted once per row.) The row styles below are global, not scoped,
// because EventsView also renders rows via innerHTML; they need an
// .events-view ancestor.
---

<li class="er">
  <span class={`er-dot ${colors.dot}`} title={e.calendarName}></span>
  <span class="er-time">{e.allDay ? 'all day' : e.time}</span>
  <span class="er-main">
    {link ? (
      <a href={link} target="_blank" rel="noopener noreferrer" class="er-title">{e.title}</a>
    ) : (
      <span class="er-title">{e.title}</span>
    )}
    {e.location && <span class="er-loc"> · {e.location}</span>}
    {e.mapUrl && (
      <a href={e.mapUrl} target="_blank" rel="noopener noreferrer" class="er-map" title="Open in Google Maps">📍(map)</a>
    )}
  </span>
  {e.costClass === 'free' ? (
    <span class="er-free">Free</span>
  ) : e.cost ? (
    <span class="er-cost">{e.cost}</span>
  ) : null}
</li>

<style is:global>
  .events-view .er {
    display: flex; align-items: baseline; gap: 0.5rem;
    padding: 0.375rem 0.5rem; margin: 0 -0.5rem; border-radius: 0.25rem;
    transition: background-color 0.15s;
  }
  .events-view .er:hover { background: rgb(250 250 249); }
  .events-view .er-dot {
    margin-top: 0.375rem; flex-shrink: 0; width: 0.5rem; height: 0.5rem; border-radius: 9999px;
  }
  .events-view .er-time {
    flex-shrink: 0; width: 4rem; text-align: right;
    font-size: 0.75rem; line-height: 1rem; font-variant-numeric: tabular-nums; color: rgb(168 162 158);
  }
  .events-view .er-main {
    flex: 1; min-width: 0; font-size: 0.875rem; line-height: 1.375; overflow-wrap: break-word;
  }
  .events-view .er-title { color: rgb(28 25 23); font-weight: 500; transition: color 0.15s; }
  .events-view a.er-title:hover { color: rgb(234 88 12); }
  .events-view .er-loc { color: rgb(168 162 158); }
  .events-view .er-map {
    margin-left: 0.25rem; white-space: nowrap; font-size: 0.75rem; color: rgb(234 88 12);
  }
  .events-view .er-map:hover { color: rgb(194 65 12); text-decoration: underline; }
  .events-view .er-free { flex-shrink: 0; font-size: 0.75rem; line-height: 1rem; font-weight: 600; color: rgb(21 128 61); }
  .events-view .er-cost { flex-shrink: 0; font-size: 0.75rem; line-height: 1rem; color: rgb(120 113 108); }
</style>
